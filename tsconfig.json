{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/**/*.ts",
    "tests/integration/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    "tests/package/**/*.ts",
    "playwright*.config.ts",
    "vitest.package.config.ts"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "allowImportingTsExtensions": true
  }
}
