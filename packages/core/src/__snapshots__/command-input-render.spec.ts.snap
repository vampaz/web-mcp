exports[`WebMCP command input rendering > renders a selected resolver option with open settings 1`] = `"<style>(styles)</style><section class="webmcp-panel" part="panel" id="webmcp-command-panel"><form class="webmcp-command" part="form" aria-label="WebMCP command input"><label class="webmcp-input-shell"><span data-label="">Command</span><input data-command-input="" part="input" type="text" autocomplete="off" spellcheck="false" placeholder="Tell this app what to do" value=""></label><button class="webmcp-run-button" part="run" type="submit" data-phase="idle">Run</button></form><p data-feedback="" part="feedback" role="status" aria-atomic="true" data-tone="info">Resolver is waiting for a command.</p><details class="webmcp-settings" open=""><summary class="webmcp-settings-summary"><span data-options-label="">Options</span><span class="webmcp-status" aria-live="polite" aria-atomic="true">Browser local AI · Hermes 3</span></summary><div class="webmcp-settings-grid"><label data-model-field=""><span>Model</span><select data-model=""><option value="hermes-3">Hermes 3</option><option value="qwen-2b">Qwen 2B</option></select></label></div></details></section>"`;

