{
  "name": "@vampaz/webmcp-kit",
  "version": "0.6.2",
  "type": "module",
  "description": "WebMCP tool registration, resolvers, framework helpers, devtools, and testing helpers for web apps.",
  "homepage": "https://github.com/vampaz/web-mcp#readme",
  "bugs": {
    "url": "https://github.com/vampaz/web-mcp/issues"
  },
  "license": "MIT",
  "author": "Carlos Rodrigues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vampaz/web-mcp.git"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "browser-ai",
    "tools",
    "agents"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "!docs/next-features.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/packages/core/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/packages/devtools/src/index.d.ts",
      "default": "./dist/devtools.js"
    },
    "./mcp-bridge": {
      "types": "./dist/packages/mcp-bridge/src/index.d.ts",
      "default": "./dist/mcp-bridge.js"
    },
    "./react": {
      "types": "./dist/packages/react/src/index.d.ts",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/packages/svelte/src/index.d.ts",
      "default": "./dist/svelte.js"
    },
    "./testing": {
      "types": "./dist/packages/testing/src/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/playwright": {
      "types": "./dist/packages/testing/src/playwright.d.ts",
      "default": "./dist/testing/playwright.js"
    },
    "./vue": {
      "types": "./dist/packages/vue/src/index.d.ts",
      "default": "./dist/vue.js"
    },
    "./zod": {
      "types": "./dist/packages/zod/src/index.d.ts",
      "default": "./dist/zod.js"
    },
    "./pi": {
      "types": "./dist/packages/pi/src/index.d.ts",
      "default": "./dist/pi.js"
    },
    "./chat": {
      "types": "./dist/packages/chat/src/index.d.ts",
      "default": "./dist/chat.js"
    },
    "./command-input": {
      "types": "./dist/packages/command-input/src/index.d.ts",
      "default": "./dist/command-input.js"
    },
    "./hosted": {
      "types": "./dist/packages/hosted/src/index.d.ts",
      "default": "./dist/hosted.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:demo": "vite --config apps/demo/vite.config.ts",
    "dev:demo:fixtures": "WEBMCP_TEST_FIXTURES=true WEBMCP_BROWSER_TEST=true vite --config apps/demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "vue-tsc --noEmit -p apps/demo/tsconfig.json",
    "test:e2e": "playwright test",
    "test:lmstudio": "node --experimental-strip-types scripts/lmstudio-preflight.ts && playwright test --config playwright.lmstudio.config.ts",
    "test:package": "vitest run --config vitest.package.config.ts",
    "pack:package": "node --experimental-strip-types scripts/package-artifact.ts",
    "docs:api": "node --experimental-strip-types scripts/generate-api-docs.ts",
    "docs:api:check": "npm run docs:api -- --check && npm run docs:links",
    "docs:links": "node --experimental-strip-types scripts/check-doc-links.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:demo && npm run docs:api:check && npm run test"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.3",
    "zod": ">=4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@vampaz/vite-plugin-local-tls": "0.2.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "2.5.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.67.0",
    "react": "^19.2.6",
    "svelte": "^5.55.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "3.3.13",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
