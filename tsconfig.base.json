{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@vampaz/webmcp-kit": ["./packages/core/src/index.ts"],
      "@vampaz/webmcp-kit/testing/playwright": ["./packages/testing/src/playwright.ts"],
      "@vampaz/webmcp-kit/*": ["./packages/*/src/index.ts"]
    }
  }
}
